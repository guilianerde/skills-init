{
  "name": "project-review",
  "order": 3,
  "requires": [
    "workflow"
  ],
  "optional": [
    "code-graph"
  ],
  "renamedFrom": {
    "code-review": "^name:\\s*code-review\\s*$[\\s\\S]*?description:\\s*\"Review source code \\("
  },
  "templates": [
    {
      "id": "checklist.md",
      "src": "references/checklist.md.tpl",
      "title": "代码审查清单",
      "summary": "project-review 逐项审查时使用的 14 维度检查清单（含幂等、DB 变更安全、测试与语言专项）。"
    },
    {
      "id": "report.md",
      "src": "references/report.md.tpl",
      "title": "代码审查报告模板",
      "summary": "project-review 落盘审查报告时使用的 Markdown 模板（含复核列与审查方式元信息）。",
      "lint": {
        "requiredMeta": [
          "审查范围",
          "对比分支",
          "审查方式"
        ]
      }
    }
  ],
  "shared": [
    "diff-collection-common.md"
  ],
  "docnexus": {
    "category": "code-review",
    "reason": "project-review skill 从审查中沉淀的反复出现的问题与约定",
    "readFrom": [
      "project-review",
      "dev"
    ]
  }
}
